
# ==================================================
# 1. GEMINI API KEY
# រក្សាទុក Key នៅក្នុង AI Studio Secrets ឬ Backend
# កុំដាក់ VITE_ នៅពីមុខឈ្មោះនេះ
# ==================================================
GEMINI_API_KEY=AQ.Ab8RN6JmgUd1ZJLqj8l-lF2BVGxJheBEeEObdoMXFQ0iJJWMVQ

# ==================================================
# 2. FIREBASE WEB APP CONFIGURATION
# ប្រើសម្រាប់ Firebase Authentication និង Frontend
# Enable Email/Password in Firebase Console > Authentication > Sign-in method.
# Existing browser-only password accounts must be recreated in Firebase Authentication.
# Deploy Firebase Functions before signing in with the verified bootstrap administrator email.
# ==================================================
VITE_FIREBASE_API_KEY=AIzaSyAuVRIXPTyammWDUpbWUknUCY7Of-FEImY
VITE_FIREBASE_AUTH_DOMAIN=drinker-92b6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=drinker-92b6c
VITE_FIREBASE_MESSAGING_SENDER_ID=168689685807
VITE_FIREBASE_APP_ID=1:168689685807:web:efe525b76b9dbc0c31fdda
VITE_FIREBASE_MEASUREMENT_ID=G-XNGV97SJY5
# Must match BOOTSTRAP_ADMIN_EMAIL in functions/.env.local / Functions parameters.
VITE_BOOTSTRAP_ADMIN_EMAIL=yonkhemra2108@gmail.com
# Set to true only after deploying the Cloud Functions backend.
VITE_FIREBASE_FUNCTIONS_ENABLED=false
# Set this to the Realtime Database URL shown in Firebase Console > Realtime Database.
VITE_FIREBASE_DATABASE_URL=https://drinker-92b6c-default-rtdb.firebaseio.com/

# ==================================================
# 3. LOCAL DEVELOPMENT URL
# ត្រូវតែដូច Port ដែល Vite ប្រើពិតប្រាកដ
# ==================================================
APP_URL=http://localhost:3000

# ==================================================
# 4. SERVER-ONLY SETTINGS
# បើកប្រើនៅពេល Backend ត្រូវការវា
# កុំដាក់ Private Key ក្នុង Frontend
# ==================================================
# GOOGLE_APPLICATION_CREDENTIALS=D:/path/to/firebase-service-account.json

# អនុញ្ញាត Origins សម្រាប់ Backend ប្រសិនបើប្រើ CORS
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
